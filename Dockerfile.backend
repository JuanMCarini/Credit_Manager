FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies needed for postgres/pg8000 and libreoffice for PDF generation
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libreoffice-core libreoffice-writer default-jre-headless fonts-liberation && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code (environment variables are injected via docker-compose / runtime)
COPY src/ ./src/

# Create non-root user (ISO/IEC 27017 / Control 8.2) and prepare writable data directories
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -d /app -s /usr/sbin/nologin appuser && \
    mkdir -p /app/data/uploads /app/data/public /app/data/certs/arca && \
    chown -R appuser:appuser /app

USER appuser

# Expose port
EXPOSE 8000

# Start server using Gunicorn with Uvicorn workers
CMD ["gunicorn", "src.api.main:app", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "-b", "0.0.0.0:8000"]
