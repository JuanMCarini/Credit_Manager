# Archivo de configuración de Entorno de Ejemplo (.env.example)
# ----------------------------------------------------
# Copia este archivo como '.env' en la raíz del proyecto
# y modifica los valores según tu entorno de desarrollo o producción.

# --- Configuración de CORS ---
# Separa los dominios permitidos por coma. Si no pones nada, usará localhost.
API_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://midominio.com","https://api.midominio.com"]

# --- Configuración de la Compañía (CompanyConfig) ---
# Esta información se utilizará para membretes, reportes y se creará 
# automáticamente como Socio Comercial al iniciar la aplicación.
COMPANY_RAZON_SOCIAL="Empresa Ficticia S.A."
COMPANY_CUIT=30000000000
COMPANY_DOMICILIO="Calle Falsa 123, Ciudad, Provincia"
COMPANY_EMAIL_CONTACTO="contacto@empresaficticia.com"
COMPANY_TELEFONO="+54 9 11 0000-0000"
COMPANY_BANK_ACCOUNT="CC $ 12345678"
COMPANY_BANK_NAME="Banco Ficticio"
COMPANY_CBU="0000000000000000000000"
COMPANY_DIA_CORTE=28

# --- Configuración de Base de Datos PostgreSQL ---
DB_USER=usuario_db
DB_PASSWORD=password_seguro
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credit_manager_db

# --- Configuración de Instancia Múltiple (Docker) ---
# ATENCIÓN: Para clonar el proyecto y correr una base de datos/instancia completamente independiente en la misma computadora,
# DEBES CAMBIAR OBLIGATORIAMENTE ESTOS 5 VALORES para que no choquen con la otra instancia:
# 1. Nombre del proyecto (aisla los contenedores y el volumen de la base de datos)
COMPOSE_PROJECT_NAME=credit_manager_instancia1
# 2. Puerto de la base de datos en tu PC (ej. 5433, 5434)
HOST_PORT_DB=5432
# 3. Puerto del backend en tu PC (ej. 8001, 8002)
HOST_PORT_BACKEND=8000
# 4. Puerto del frontend de producción en tu PC (ej. 81, 82)
HOST_PORT_FRONTEND=80
# 5. Puerto del frontend de desarrollo en tu PC (ej. 5174, 5175)
HOST_PORT_FRONTEND_DEV=5173

# IMPORTANTE: Si cambias los puertos del frontend (pasos 4 y 5), también debes actualizar 
# API_ALLOWED_ORIGINS arriba para que incluya los nuevos puertos (ej. http://localhost:5174)
